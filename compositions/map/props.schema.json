{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "map props",
  "type": "object",
  "properties": {
    "region": { "type": "string", "description": "The area shown, named in the header." },
    "markers": {
      "type": "array", "description": "Places to pin; dropped onto the map in sequence.",
      "minItems": 1, "items": { "type": "string" }
    }
  },
  "required": ["region", "markers"],
  "additionalProperties": false
}
