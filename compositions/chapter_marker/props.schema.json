{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chapter_marker props",
  "type": "object",
  "properties": {
    "number": { "type": ["string", "number"], "description": "Chapter number, e.g. \"01\"" },
    "name": { "type": "string", "description": "Chapter title" },
    "x": { "type": "number", "default": 0 },
    "y": { "type": "number", "default": 0 }
  },
  "required": ["name"],
  "additionalProperties": false
}
